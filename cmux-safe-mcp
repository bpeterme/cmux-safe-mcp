def tools_for(cfg):
    return [t for t in TOOLS if t[0] not in EXTRA_TOOLS or (cfg and EXTRA_TOOLS[t[0]] in cfg["allow"])]


def tool_specs(cfg):
    return [{"name": n, "description": d, "inputSchema": {"type": "object", "properties": props, "required": req,
                                                          "additionalProperties": False}}
            for n, _, d, props, req in tools_for(cfg)]


def call(cfg, name, args):
    tool = next((t for t in tools_for(cfg) if t[0] == name), None)
    if not tool:
        raise Refused(f"unknown tool {name}")
    if not isinstance(args, dict):
        raise Refused("arguments must be an object")
    extra = set(args) - set(tool[3])
    if extra:
        raise Refused(f"{name} does not take {', '.join(sorted(extra))}")
    return tool[1](cfg, args)


# --- MCP over stdio --------------------------------------------------------------

def serve(inp=sys.stdin, out=sys.stdout):
    def reply(mid, **kw):
        out.write(json.dumps({"jsonrpc": "2.0", "id": mid, **kw}) + "\n")
        out.flush()

    for raw in inp:
        try:
            msg = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(msg, dict) or msg.get("id") is None:
            continue  # notifications need no answer
        mid, method, params = msg["id"], msg.get("method"), msg.get("params") or {}
        try:
            cfg, problem = load_config(), None
        except Refused as e:
            cfg, problem = None, str(e)
        if method == "initialize":
            reply(mid, result={"protocolVersion": params.get("protocolVersion") or "2025-06-18",
                               "capabilities": {"tools": {}},
                               "serverInfo": {"name": "cmux-safe-mcp", "version": VERSION}, "instructions": NOTE})
        elif method == "ping":
            reply(mid, result={})
        elif method == "tools/list":
            reply(mid, result={"tools": tool_specs(cfg)})
        elif method == "tools/call":
            try:
                if problem:
                    raise Refused(problem)
                text, failed = json.dumps(call(cfg, params.get("name"), params.get("arguments") or {}),
                                          indent=2, ensure_ascii=False), False
            except Refused as e:
                text, failed = str(e), True
            reply(mid, result={"content": [{"type": "text", "text": text}], "isError": failed})
        else:
            reply(mid, error={"code": -32601, "message": f"unknown method {method}"})


def check():
    try:
        cfg = load_config()
    except Refused as e:
        print(f"✖ {e}")
        return 1
    print(f"✔ settings: {tilde(config_path())}; repos go to {tilde(cfg['folder'])}")
    for n, s in cfg["sources"]:
        print(f"  {n}: {', '.join(patterns(s))}  (clone {s['clone']})")
    try:
        items = workspaces(cfg)
    except Refused as e:
        print(f"✖ {e}")
        return 1
    print(f"✔ cmux answers: {len(items)} workspaces")
    print(f"  tools: {', '.join(t[0] for t in tools_for(cfg))}")
    if "panes" in cfg["allow"]:
        print(f"  panes: up to {cfg['max_panes']}, commands: "
              + ", ".join(f"{n} = {c}" for n, c in sorted(cfg["commands"].items())))
    if os.environ.get("CMUX_WORKSPACE_ID"):
        print("ℹ  This terminal is inside cmux, which cmux lets in anyway. A background process (like\n"
              "   cbox's relay) may not be: check from another terminal app too.")
    return 0


HELP = """cmux-safe-mcp — only the safe parts of cmux, as an MCP server

Settings: {path}

  [settings]
  folder  = ~/Workspace           # where repos go (optional)
  command = cbox                  # optional: run in each opened workspace (e.g. cbox, claude)
  allow   = close panes           # optional: also close workspaces / open and drive its own panes
  max_panes = 4                   # optional: panes open at once on this Mac (allow = panes)
  cmux    = /path/to/cmux         # optional: when cmux is not on the PATH

  [commands]                      # allow = panes: what a pane may run, by name
  worker  = cbox

  [github]                        # a git host; any name, the first one is tried first
  repos   = my-user/*, my-org/app # owner/name patterns the agent may open
  clone   = git@github.com:{{repo}}.git   # optional (this is the default)

  [gitlab]
  repos   = my-group/*            # * also covers subgroups
  clone   = git@gitlab.com:{{repo}}.git

Add it to your MCP client:
  Claude Code:  claude mcp add cmux -- {exe}
  cbox:         ~/.config/claudebox/mcp.json  →  "cmux": {{"command": "{exe}"}}

  cmux-safe-mcp check    tests the settings and the connection to cmux
"""


def main(argv):
    if argv[1:] == ["check"]:
        return check()
    if argv[1:] in (["--version"], ["version"]):
        print(f"cmux-safe-mcp {VERSION}")
        return 0
    if argv[1:] or sys.stdin.isatty():
        print(HELP.format(path=tilde(config_path()), exe=os.path.realpath(argv[0])))
        return 0 if argv[1:] in (["--help"], ["-h"], ["help"], []) else 2
    serve()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
