#!/usr/bin/env python3
"""cmux-safe-mcp — an MCP server with only the safe parts of cmux.

Lets an agent you don't want at your keyboard work with cmux: list workspaces,
open a repo in a new workspace (cloned when missing), switch to, rename, color,
describe, pin and (opt-in) close workspaces, and notify you or show status in
its own sidebar entry. Opt-in (allow = panes): open panes next to its own that
run a command you named in the settings, and type into, read and close only
those panes. Never: typing into or reading any other terminal, running a command
of the agent's choice, the browser, or any other cmux command.

Made for agents in containers (e.g. cbox, whose host MCP relay runs it on the
Mac), and useful for any MCP client. Settings: ~/.config/cmux-safe-mcp/config.

  cmux-safe-mcp          MCP server on stdin/stdout
  cmux-safe-mcp check    tests the settings and the connection to cmux
"""
import configparser, fcntl, hashlib, json, os, re, shutil, subprocess, sys, tempfile
from fnmatch import fnmatchcase

VERSION = "dev"  # set by the Homebrew formula: the release date (YYYY.MM.DD.N) or HEAD-<sha>
DEFAULT_FOLDER = "~/Workspace"
DEFAULT_CLONE = "git@github.com:{repo}.git"
COLORS = ("Red", "Crimson", "Orange", "Amber", "Olive", "Green", "Teal", "Aqua",
          "Blue", "Navy", "Indigo", "Purple", "Magenta", "Rose", "Brown", "Charcoal")
HEX_COLOR_RE = re.compile(r"^#[0-9A-Fa-f]{6}$")
# A repo: owner/name (GitHub) or group/subgroup/.../name (GitLab, up to 20
# groups deep). Each part: letters, digits, '_', '-', '.', never starting with
# '-' or '.' (so no option-like names and no "." or "..").
REPO_PART = r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}"
REPO_RE = re.compile(rf"^{REPO_PART}(?:/{REPO_PART}){{1,20}}$")
PATTERN_PART = r"[A-Za-z0-9_*?][A-Za-z0-9_.*?-]{0,99}"
PATTERN_RE = re.compile(rf"^{PATTERN_PART}(?:/{PATTERN_PART}){{1,20}}$")
SOURCE_RE = re.compile(r"^[a-z0-9][a-z0-9_.-]{0,63}$")
WORKSPACE_RE = re.compile(r"^(workspace:\d{1,20}|[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-"
                          r"[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})$")
STATUS_KEY_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,31}$")
SURFACE_RE = re.compile(r"^(surface:\d{1,20}|[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-"
                        r"[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})$")
COMMAND_NAME_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,31}$")
EXTRAS = {"close", "panes"}  # actions that stay off unless listed in allow =
SETTINGS_KEYS = {"folder", "allow", "cmux", "command", "max_panes"}
DEFAULT_MAX_PANES = 4
# Keys a pane may get, by the name the agent uses: cmux send-key's names.
KEYS = {"enter": "enter", "escape": "escape", "tab": "tab", "up": "up", "down": "down",
        "ctrl-c": "ctrl-c"}
READ_LINES_MAX = 200
SOURCE_KEYS = {"repos", "clone"}
# Fields of cmux's workspace list passed on. Not the others: cmux also reports
# the latest messages of agents running in each workspace.
LIST_FIELDS = ("ref", "title", "custom_color", "description", "current_directory", "pinned", "selected")


class Refused(Exception):
    """A request the server turns down, with what to do instead."""


# --- settings -------------------------------------------------------------------

def config_path():
    if os.environ.get("CMUX_SAFE_MCP_CONFIG"):
        return os.path.expanduser(os.environ["CMUX_SAFE_MCP_CONFIG"])
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "cmux-safe-mcp", "config")


def patterns(src):
    return [p for p in src.get("repos", "").replace(",", " ").split() if p]


def load_config(path=None):
    """{"folder", "allow", "cmux", "sources": [(name, {"repos", "clone"}), ...]}.
    Problems raise Refused with the line to fix."""
    path = path or config_path()
    cp = configparser.ConfigParser(interpolation=None, inline_comment_prefixes=("#",), delimiters=("=",))
    try:
        if not cp.read(path):
            raise Refused(f"no settings file: create {tilde(path)} (see: cmux-safe-mcp --help)")
    except configparser.Error as e:
        raise Refused(f"{tilde(path)} is not valid: {e}")
    s = dict(cp["settings"]) if cp.has_section("settings") else {}
    extra = set(s) - SETTINGS_KEYS
    if extra:
        raise Refused(f"[settings] {', '.join(sorted(extra))} is unknown (known: {', '.join(sorted(SETTINGS_KEYS))})")
    allow = {a for a in s.get("allow", "").replace(",", " ").split() if a}
    if allow - EXTRAS:
        raise Refused(f"[settings] allow = {', '.join(sorted(allow - EXTRAS))} is unknown (known: {', '.join(sorted(EXTRAS))})")
    folder = os.path.expanduser(s.get("folder", DEFAULT_FOLDER))
    if not os.path.isabs(folder):
        raise Refused("[settings] folder must be an absolute path, e.g. folder = ~/Workspace")
    commands = dict(cp["commands"]) if cp.has_section("commands") else {}
    for name, line in commands.items():
        if not COMMAND_NAME_RE.match(name):
            raise Refused(f"[commands] {name}: a name may only contain a-z, 0-9, '_' and '-'")
        if not line.strip() or any(ord(c) < 32 or ord(c) == 127 for c in line):
            raise Refused(f"[commands] {name} must be one command on one line, e.g. {name} = cbox")
    try:
        max_panes = int(s.get("max_panes", DEFAULT_MAX_PANES))
    except ValueError:
        max_panes = -1
    if not 1 <= max_panes <= 32:
        raise Refused("[settings] max_panes must be a number from 1 to 32")
    if "panes" in allow and not commands:
        raise Refused("allow = panes needs a [commands] section: the commands a pane may run, e.g. worker = cbox")
    sources = []
    for name in cp.sections():
        if name in ("settings", "commands"):
            continue
        src = dict(cp[name])
        if not SOURCE_RE.match(name):
            raise Refused(f"[{name}]: a name may only contain a-z, 0-9, '.', '_' and '-'")
        if set(src) - SOURCE_KEYS:
            raise Refused(f"[{name}] {', '.join(sorted(set(src) - SOURCE_KEYS))} is unknown (known: repos, clone)")
        if not patterns(src):
            raise Refused(f"[{name}] repos is missing: the owner/name patterns to open, e.g. repos = my-org/*")
        for p in patterns(src):
            if not PATTERN_RE.match(p):
                raise Refused(f"[{name}] repos entry '{p}' is not an owner/name pattern "
                              "(e.g. my-org/*, my-user/notes or my-group/sub/*)")
        if "{repo}" not in src.get("clone", "{repo}"):
            raise Refused(f"[{name}] clone must contain {{repo}}, e.g. clone = git@github.com:{{repo}}.git")
        sources.append((name, {"repos": src["repos"], "clone": src.get("clone", DEFAULT_CLONE)}))
    command = s.get("command", "").strip()
    if any(ord(c) < 32 or ord(c) == 127 for c in command):
        raise Refused("[settings] command must be one line")
    return {"folder": os.path.realpath(folder), "allow": allow, "cmux": s.get("cmux", ""),
            "command": command, "sources": sources,
            "commands": {n: c.strip() for n, c in commands.items()}, "max_panes": max_panes}


def tilde(path):
    home = os.path.realpath(os.path.expanduser("~"))
    path = os.path.realpath(path)
    return "~" + path[len(home):] if path == home or path.startswith(home + os.sep) else path


# --- cmux -----------------------------------------------------------------------

def cmux(cfg, args):
    """Output of the cmux CLI with args, as a list (never a shell). The caller's
    workspace and surface are dropped from the environment, so nothing targets
    a workspace by default: every command names its workspace."""
    exe = os.path.expanduser(cfg["cmux"]) if cfg.get("cmux") else shutil.which("cmux")
    if not exe:
        raise Refused("cmux command not found — set its path in the settings: [settings] cmux = <path> "
                      "(in a cmux terminal: command -v cmux)")
    env = {k: v for k, v in os.environ.items()
           if not k.startswith("CMUX_") or k in ("CMUX_SOCKET_PATH", "CMUX_SOCKET_PASSWORD")}
    env["CMUX_QUIET"] = "1"
    try:
        p = subprocess.run([exe] + args, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                           stderr=subprocess.PIPE, timeout=30)
    except (OSError, subprocess.SubprocessError) as e:
        raise Refused(f"cmux did not run: {e.__class__.__name__}")
    out, errs = p.stdout.decode(errors="replace").strip(), p.stderr.decode(errors="replace").strip()
    if p.returncode != 0:
        msg = (errs or out)[-300:] or "no output"
        hint = (" — cmux lets in only processes started in cmux terminals by default; in cmux's settings, "
                "choose password mode (cmux then uses the password saved there)") if "denied" in msg.lower() else ""
        raise Refused(f"cmux {args[0]} failed: {msg}{hint}")
    return out


def workspaces(cfg):
    try:
        data = json.loads(cmux(cfg, ["list-workspaces", "--json"]))
    except ValueError:
        raise Refused("cmux list-workspaces gave no JSON")
    items = data.get("workspaces") if isinstance(data, dict) else None
    if not isinstance(items, list):
        raise Refused("cmux list-workspaces gave no workspace list")
    return [w for w in items if isinstance(w, dict)]


def own_workspace(items):
    """The ref of the workspace this session runs in, or None: cmux sets
    CMUX_WORKSPACE_ID in its terminals, and an MCP client started there (or
    cbox's relay) passes it on. Without it, the one workspace whose folder is
    the folder the client was started in (PWD)."""
    wid = os.environ.get("CMUX_WORKSPACE_ID", "")
    if wid:
        for w in items:
            if wid in (w.get("id"), w.get("ref")):
                return w.get("ref")
    pwd = os.environ.get("PWD", "")
    if pwd:
        here = [w for w in items if w.get("current_directory")
                and os.path.realpath(w["current_directory"]) == os.path.realpath(pwd)]
        if len(here) == 1:
            return here[0].get("ref")
    return None


# --- argument checks -------------------------------------------------------------

def text_arg(args, key, limit, required=True):
    v = args.get(key)
    if v is None or v == "":
        if required:
            raise Refused(f"{key} is missing")
        return None
    if not isinstance(v, str):
        raise Refused(f"{key} must be a string")
    if len(v) > limit:
        raise Refused(f"{key} is longer than {limit} characters")
    if any(ord(c) < 32 or ord(c) == 127 for c in v):
        raise Refused(f"{key} must be one line, without control characters")
    if v.startswith("-"):
        raise Refused(f"{key} must not start with '-'")
    return v


def workspace_arg(cfg, args):
    w = args.get("workspace")
    if not isinstance(w, str) or not WORKSPACE_RE.match(w):
        raise Refused("workspace must be a ref like workspace:12 or a workspace id (see cmux_list)")
    return w


def color_value(repo_or_none, asked):
    """A cmux color name or #RRGGBB as cmux takes it; without asked, a named
    color picked by the repo's name (the same repo always gets the same)."""
    if asked:
        named = {c.lower(): c for c in COLORS}
        if not isinstance(asked, str):
            raise Refused("color must be a string")
        if asked.lower() in named:
            return named[asked.lower()]
        if HEX_COLOR_RE.match(asked):
            return asked.upper()
        raise Refused(f"color must be #RRGGBB or one of {', '.join(COLORS)}")
    return COLORS[hashlib.sha256(repo_or_none.lower().encode()).digest()[0] % len(COLORS)]


# --- opening a repo --------------------------------------------------------------

def git_origin(path):
    try:
        p = subprocess.run(["git", "-C", path, "remote", "get-url", "origin"], stdin=subprocess.DEVNULL,
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return p.stdout.decode(errors="replace").strip() if p.returncode == 0 else None


def same_remote(a, b):
    norm = lambda u: re.sub(r"(\.git)?/*$", "", (u or "").strip()).lower()
    return bool(a) and norm(a) == norm(b)


def clone_url(src, repo):
    return src["clone"].replace("{repo}", repo)


def candidates(cfg, repo, source=None):
    """[(source name, source, owner/name)] that may be opened for repo, in the
    settings' order. A bare name gets its owner from patterns with a fixed
    owner (my-user/*, someone/notes): the agent cannot see the patterns."""
    if not isinstance(repo, str) or not repo:
        raise Refused("repo is missing")
    sources = cfg["sources"]
    if not sources:
        raise Refused(f"no repos to open: add a section to {tilde(config_path())}, e.g. [github] repos = my-user/*")
    if source is not None:
        sources = [(n, s) for n, s in sources if n == source]
        if not sources:
            raise Refused(f"source must be one of: {', '.join(n for n, _ in cfg['sources'])}")
    if repo.lower().endswith(".git"):
        raise Refused("repo must be a name or owner/name, without .git")
    if "/" in repo:
        if not REPO_RE.match(repo):
            raise Refused("repo must be a name or owner/name (GitLab: group/subgroup/name)")
        found = [(n, s, repo) for n, s in sources if any(fnmatchcase(repo.lower(), p.lower()) for p in patterns(s))]
        if not found:
            raise Refused(f"{repo} is not among the repos you set up to open "
                          f"({'; '.join(f'{n}: ' + ', '.join(patterns(s)) for n, s in sources)})")
        return found
    if not re.fullmatch(REPO_PART, repo):
        raise Refused("repo must be a name or owner/name (GitLab: group/subgroup/name)")
    found = []
    for n, s in sources:
        owners = {}
        for p in patterns(s):
            head, _, last = p.rpartition("/")
            if not any(c in head for c in "*?") and fnmatchcase(repo.lower(), last.lower()):
                owners.setdefault(f"{head}/{repo}".lower(), f"{head}/{repo}")
        if len(owners) > 1:
            # Two owners in one source are two different projects: never guess.
            local = local_choice(cfg, repo, [(n, s, r) for r in owners.values()])
            if not local:
                raise Refused(f"{repo} could be {' or '.join(sorted(owners.values()))} — give owner/name")
            found.append(local)
        elif owners:
            found.append((n, s, next(iter(owners.values()))))
    if not found:
        raise Refused(f"give owner/name: no repos setting fixes the owner of {repo}")
    return found


def local_choice(cfg, name, found):
    """The candidate whose clone is already in the folder, if exactly one."""
    path = os.path.join(cfg["folder"], name)
    origin = git_origin(path) if os.path.isdir(path) else None
    hits = [c for c in found if same_remote(origin, clone_url(c[1], c[2]))]
    return hits[0] if len(hits) == 1 else None


class Lock:
    """One open at a time on this Mac: no two clones into one folder (each
    agent connection is its own process)."""
    def __enter__(self):
        self.f = open(os.path.join(tempfile.gettempdir(), f"cmux-safe-mcp-{os.getuid()}.lock"), "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)

    def __exit__(self, *a):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


def clone(url, path):
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    env.setdefault("GIT_SSH_COMMAND", "ssh -o BatchMode=yes")
    try:
        p = subprocess.run(["git", "clone", "--quiet", "--", url, path], env=env, stdin=subprocess.DEVNULL,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=900)
    except (OSError, subprocess.SubprocessError) as e:
        return f"did not finish ({e.__class__.__name__})"
    if p.returncode != 0:
        return (p.stdout.decode(errors="replace").strip().splitlines() or ["failed"])[-1][:300]
    return None


def tool_open(cfg, args):
    found = candidates(cfg, args.get("repo"), args.get("source"))
    name = found[0][2].rsplit("/", 1)[1]
    path = os.path.join(cfg["folder"], name)
    with Lock():
        if os.path.lexists(path):
            hit = local_choice(cfg, name, found) if os.path.isdir(path) else None
            if not hit:
                raise Refused(f"{tilde(path)} exists and is not a clone of "
                              f"{' or '.join(clone_url(s, r) for _, s, r in found)} — move it away or open it by hand")
            (source, _, repo), cloned = hit, False
        else:
            os.makedirs(cfg["folder"], exist_ok=True)
            failures = []
            for source, src, repo in found:  # the same repo on several hosts: the first that has it
                problem = clone(clone_url(src, repo), path)
                if not problem:
                    break
                failures.append(f"{source}: git clone {clone_url(src, repo)}: {problem}")
            else:
                raise Refused("could not clone — " + "; ".join(failures))
            cloned = True
        color = color_value(repo, args.get("color"))
        # The first command comes from the user's settings only, never from the agent.
        start = ["--command", cfg["command"]] if cfg["command"] else []
        out = cmux(cfg, ["new-workspace", "--name", name, "--cwd", path, *start])
        m = re.search(r"\bworkspace:\d+\b", out) or re.search(
            r"\b[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\b", out)
        if not m:
            raise Refused(f"cmux new-workspace gave no workspace: {out[-300:] or 'no output'}")
        result = {"repo": repo, "source": source, "workspace": m.group(0), "folder": tilde(path),
                  "cloned": cloned, "color": color}
        try:
            cmux(cfg, ["workspace-action", "--action", "set-color", "--color", color, "--workspace", m.group(0)])
        except Refused as e:
            result["warning"] = f"the workspace is open, but its color is not set: {e}"
        return result


# --- the other tools -------------------------------------------------------------

def tool_list(cfg, args):
    items = workspaces(cfg)
    own = own_workspace(items)
    out = []
    for w in items:
        entry = {"workspace": w.get("ref"), "title": w.get("title"), "color": w.get("custom_color"),
                 "description": w.get("description"),
                 "folder": tilde(w["current_directory"]) if w.get("current_directory") else None,
                 "pinned": bool(w.get("pinned")), "selected": bool(w.get("selected"))}
        if own and w.get("ref") == own:
            entry["this_session"] = True
        out.append(entry)
    return {"workspaces": out}


def action(cfg, w, *extra):
    cmux(cfg, ["workspace-action", *extra, "--workspace", w])


def tool_select(cfg, args):
    w = workspace_arg(cfg, args)
    cmux(cfg, ["select-workspace", "--workspace", w])
    return {"selected": w}


def tool_rename(cfg, args):
    w, title = workspace_arg(cfg, args), text_arg(args, "title", 100)
    action(cfg, w, "--action", "rename", "--title", title)
    return {"workspace": w, "title": title}


def tool_color(cfg, args):
    w = workspace_arg(cfg, args)
    if args.get("color") in (None, "", "none"):
        action(cfg, w, "--action", "clear-color")
        return {"workspace": w, "color": None}
    color = color_value(None, args["color"])
    action(cfg, w, "--action", "set-color", "--color", color)
    return {"workspace": w, "color": color}


def tool_describe(cfg, args):
    w, text = workspace_arg(cfg, args), text_arg(args, "description", 500, required=False)
    if text is None:
        action(cfg, w, "--action", "clear-description")
    else:
        action(cfg, w, "--action", "set-description", "--description", text)
    return {"workspace": w, "description": text}


def tool_pin(cfg, args):
    w = workspace_arg(cfg, args)
    if not isinstance(args.get("pinned"), bool):
        raise Refused("pinned must be true or false")
    action(cfg, w, "--action", "pin" if args["pinned"] else "unpin")
    return {"workspace": w, "pinned": args["pinned"]}


def own_or_refuse(cfg):
    own = own_workspace(workspaces(cfg))
    if not own:
        raise Refused("this session's workspace is unknown: start the agent (or cbox) from a cmux terminal")
    return own


def tool_notify(cfg, args):
    title, body = text_arg(args, "title", 100), text_arg(args, "body", 500, required=False)
    own = own_or_refuse(cfg)
    cmux(cfg, ["notify", "--title", title, *(["--body", body] if body else []), "--workspace", own])
    return {"notified": True, "workspace": own}


def tool_status(cfg, args):
    key = args.get("key") or "agent"
    if not isinstance(key, str) or not STATUS_KEY_RE.match(key):
        raise Refused("key may only contain letters, digits, '_', '.' and '-' (up to 32)")
    value = text_arg(args, "value", 100, required=False)
    own = own_or_refuse(cfg)
    if value is None:
        cmux(cfg, ["clear-status", key, "--workspace", own])
    else:
        cmux(cfg, ["set-status", key, value, "--workspace", own])
    return {"workspace": own, "key": key, "value": value}


def tool_progress(cfg, args):
    value = args.get("value")
    label = text_arg(args, "label", 100, required=False)
    own = own_or_refuse(cfg)
    if value is None:
        cmux(cfg, ["clear-progress", "--workspace", own])
        return {"workspace": own, "progress": None}
    if isinstance(value, bool) or not isinstance(value, (int, float)) or not 0 <= value <= 1:
        raise Refused("value must be a number from 0 to 1, or null to clear")
    cmux(cfg, ["set-progress", f"{float(value):.3f}", *(["--label", label] if label else []), "--workspace", own])
    return {"workspace": own, "progress": value, "label": label}


def tool_close(cfg, args):
    w = workspace_arg(cfg, args)
    items = workspaces(cfg)
    if w in (own_workspace(items), next((x.get("id") for x in items if x.get("ref") == own_workspace(items)), None)):
        raise Refused("this is the session's own workspace: closing it would end this session")
    cmux(cfg, ["close-workspace", "--workspace", w])
    return {"closed": w}


# --- panes (opt-in: allow = panes) ----------------------------------------------
#
# A pane belongs to the session that opened it (cmux's CMUX_SURFACE_ID of that
# session, which cbox's relay passes per session). Only its owner may type into,
# read or close it; the record lives in a state file, so a restarted session in
# the same terminal finds its panes again. Limits count panes that still exist.

def state_path():
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(base, "cmux-safe-mcp", "panes.json")


def load_panes():
    try:
        with open(state_path()) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    return {k: v for k, v in data.items() if isinstance(v, dict)} if isinstance(data, dict) else {}


def save_panes(panes):
    path = state_path()
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + f".{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(panes, f, indent=2, sort_keys=True)
    os.replace(tmp, path)


def own_surface():
    """The calling session's own pane (cmux sets CMUX_SURFACE_ID), or Refused."""
    surface = os.environ.get("CMUX_SURFACE_ID", "")
    if not SURFACE_RE.match(surface):
        raise Refused("this session's pane is unknown: start the agent (or cbox) from a cmux terminal")
    return surface


def alive(cfg, ref, rec):
    try:
        cmux(cfg, ["read-screen", "--workspace", rec["workspace"], "--surface", ref, "--lines", "1"])
        return True
    except Refused:
        return False


def prune(cfg, panes):
    """Drops records of panes that are gone (their command ended or someone closed them)."""
    gone = [ref for ref, rec in panes.items() if not alive(cfg, ref, rec)]
    for ref in gone:
        del panes[ref]
    return bool(gone)


def owned_pane(cfg, args):
    ref = args.get("pane")
    if not isinstance(ref, str) or not SURFACE_RE.match(ref):
        raise Refused("pane must be a ref like surface:12, from cmux_pane_open or cmux_pane_list")
    surface = own_surface()
    rec = load_panes().get(ref)
    if not rec or rec.get("owner") != surface:
        raise Refused(f"{ref} is not a pane this session opened (see cmux_pane_list)")
    return ref, rec


def tool_pane_open(cfg, args):
    name = args.get("command")
    if not isinstance(name, str) or name not in cfg["commands"]:
        raise Refused(f"command must be one of: {', '.join(sorted(cfg['commands']))} (the user's [commands])")
    direction = args.get("direction") or "right"
    if direction not in ("right", "down"):
        raise Refused("direction must be right or down")
    label = text_arg(args, "label", 60, required=False)
    surface, own = own_surface(), own_or_refuse(cfg)
    with Lock():
        panes = load_panes()
        if prune(cfg, panes):
            save_panes(panes)
        if len(panes) >= cfg["max_panes"]:
            raise Refused(f"{len(panes)} panes are open, the most the user allows (max_panes = {cfg['max_panes']}) "
                          "— close one first (cmux_pane_close)")
        # The command comes from the user's settings only. exec: the pane closes when it ends.
        out = cmux(cfg, ["new-split", direction, "--workspace", own, "--surface", surface,
                         "--command", f"exec {cfg['commands'][name]} || exit"])
        m = re.search(r"\bsurface:\d+\b", out)
        if not m:
            raise Refused(f"cmux new-split gave no pane: {out[-300:] or 'no output'}")
        panes[m.group(0)] = {"owner": surface, "workspace": own, "command": name, "label": label}
        save_panes(panes)
    if label:
        try:
            cmux(cfg, ["rename-tab", "--workspace", own, "--surface", m.group(0), label])
        except Refused:
            pass  # the label is a nicety
    return {"pane": m.group(0), "command": name, "label": label}


def tool_pane_list(cfg, args):
    surface = own_surface()
    with Lock():
        panes = load_panes()
        if prune(cfg, panes):
            save_panes(panes)
    mine = [{"pane": ref, "command": rec.get("command"), "label": rec.get("label")}
            for ref, rec in sorted(panes.items()) if rec.get("owner") == surface]
    return {"panes": mine, "open": len(panes), "max_panes": cfg["max_panes"]}


def tool_pane_send(cfg, args):
    ref, rec = owned_pane(cfg, args)
    text = text_arg(args, "text", 4000)
    enter = args.get("enter", True)
    if not isinstance(enter, bool):
        raise Refused("enter must be true or false")
    cmux(cfg, ["send", "--workspace", rec["workspace"], "--surface", ref, text])
    if enter:
        cmux(cfg, ["send-key", "--workspace", rec["workspace"], "--surface", ref, "enter"])
    return {"pane": ref, "sent": True, "enter": enter}


def tool_pane_key(cfg, args):
    ref, rec = owned_pane(cfg, args)
    key = args.get("key")
    if key not in KEYS:
        raise Refused(f"key must be one of: {', '.join(KEYS)}")
    cmux(cfg, ["send-key", "--workspace", rec["workspace"], "--surface", ref, KEYS[key]])
    return {"pane": ref, "key": key}


def tool_pane_read(cfg, args):
    ref, rec = owned_pane(cfg, args)
    lines = args.get("lines", 50)
    if isinstance(lines, bool) or not isinstance(lines, int) or not 1 <= lines <= READ_LINES_MAX:
        raise Refused(f"lines must be a number from 1 to {READ_LINES_MAX}")
    return {"pane": ref, "screen": cmux(cfg, ["read-screen", "--workspace", rec["workspace"], "--surface", ref,
                                              "--lines", str(lines)])}


def tool_pane_close(cfg, args):
    ref, rec = owned_pane(cfg, args)
    with Lock():
        try:
            cmux(cfg, ["close-surface", "--workspace", rec["workspace"], "--surface", ref, "--force"])
        except Refused:
            if alive(cfg, ref, rec):
                raise
        panes = load_panes()
        panes.pop(ref, None)
        save_panes(panes)
    return {"closed": ref}


